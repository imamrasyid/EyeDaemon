# ============================================================================
# EyeDaemon - Unified Architecture Configuration
# ============================================================================

# Discord Bot Configuration
# Required: Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Required: Your bot's client ID (Application ID)
DISCORD_CLIENT_ID=your_client_id_here

# Command prefix (default: !)
DISCORD_PREFIX=!

# Optional: Guild ID for development/testing
DISCORD_GUILD_ID=

# DJ role name for music control permissions
DISCORD_DJ_ROLE=DJ

# Comma-separated list of channels where music channels are restricted (empty = all channels)
DISCORD_MUSIC_CHANNELS=

# Bot Owner Configuration (for owner-only commands)
BOT_OWNER_ID=your_discord_user_id_here

# ============================================================================
# Database Configuration (LibSQL / SQLite / Turso)
# ============================================================================
# For local SQLite development (default, zero setup):
TURSO_DATABASE_URL=file:./data/eyedaemon.db
TURSO_AUTH_TOKEN=

# For remote Turso DB in production:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional: Embedded replica sync settings
# TURSO_SYNC_URL=
# TURSO_SYNC_INTERVAL=60000

# ============================================================================
# Audio & Streaming Configuration (In-Process Unified Pipeline)
# ============================================================================
# yt-dlp binary path (default: 'yt-dlp' in system PATH)
YTDLP_PATH=yt-dlp

# Optional custom FFmpeg path (auto-uses bundled ffmpeg-static if omitted)
FFMPEG_PATH=

# YouTube Cookie authentication (prevents bot blocks/throttling)
# Option 1: Path to cookies.txt file
# YTDLP_COOKIES_FILE=./cookies.txt
# Option 2: Browser name (chrome, firefox, edge, brave, etc.)
# YTDLP_COOKIES_BROWSER=chrome

# Default audio settings
AUDIO_VOLUME_DEFAULT=80
AUDIO_VOLUME_MAX=200
AUDIO_BITRATE=128000

# ============================================================================
# Embedded HTTP Server & Health Check API
# ============================================================================
ENABLE_HTTP_SERVER=true
PORT=3000
HOST=0.0.0.0

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info
LOG_PRETTY=true
LOG_FILE=./logs/bot.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_MUSIC=true
FEATURE_MODERATION=true
FEATURE_ECONOMY=true
FEATURE_LEVELING=true
FEATURE_TICKETS=true
FEATURE_LOGGING=true

# ============================================================================
# Economy Configuration
# ============================================================================
ECONOMY_STARTING_BALANCE=1000
ECONOMY_DAILY_REWARD=500
ECONOMY_WORK_MIN=100
ECONOMY_WORK_MAX=500
ECONOMY_TRANSFER_TAX=0.05

# ============================================================================
# Leveling Configuration
# ============================================================================
LEVELING_XP_MESSAGE_MIN=5
LEVELING_XP_MESSAGE_MAX=15
LEVELING_XP_VOICE=1
LEVELING_BASE=100
LEVELING_MULTIPLIER=1.5

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_DEFAULT=3000
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_BURST=5

# Environment (development, production, test)
NODE_ENV=development
